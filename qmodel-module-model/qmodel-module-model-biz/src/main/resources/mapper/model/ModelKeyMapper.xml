<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qmodel.module.model.dal.mapper.modelKey.ModelKeyMapper">


    <select id="selectUserList" resultType="tech.qiantong.qmodel.common.core.domain.entity.SysUser">
        SELECT su.*
        FROM system_user su
        WHERE su.del_flag = 0
        and su.user_id in (
            SELECT mk.user_id from model_key mk
            WHERE mk.del_flag = 0
              and mk.valid_flag = 1
              and mk.api_key = #{apiKey}
        )
    </select>
</mapper>
