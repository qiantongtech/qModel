            <if test="executionLog != null  and executionLog != ''"> and execution_log = #{executionLog}</if>
            <if test="errorMessage != null  and errorMessage != ''"> and error_message = #{errorMessage}</if>
            <if test="retryCount != null "> and retry_count = #{retryCount}</if>
            <if test="resourceUsage != null  and resourceUsage != ''"> and resource_usage = #{resourceUsage}</if>
            <if test="createTime != null "> and create_time = #{createTime}</if>
        </where>
    </select>

    <select id="selectModelCalcExecutionById" parameterType="Long" resultMap="ModelCalcExecutionResult">
